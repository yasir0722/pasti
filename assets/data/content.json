      "id": "hadis",
      "title": "Hadis",
      "eyebrow": "Hafalan harian",
      "description": "20 hadis pendek untuk dibaca dan dihafal bersama.",
      "icon": "✦",
      "tone": "peach",
      "items": [
        { "id": "hadis-01", "number": 1, "title": "Sebaik-Baik Amalan", "arabic": "إِنَّمَا الأَعْمَالُ بِالنِّيَّاتِ", "translation": "Sesungguhnya amalan itu dinilai dengan niat.", "image": "assets/images/hadis/hadis01.jpg", "audio": "assets/audio/hadis/hadis-01.mp3", "introAudio": "assets/audio/hadis/hadis-01-ms.mp3" },
        { "id": "hadis-02", "number": 2, "title": "Larangan Menderhakai Ibu", "arabic": "إِنَّ اللَّهَ حَرَّمَ عَلَيْكُمْ عُقُوقَ الْأُمَّهَاتِ", "translation": "Sesungguhnya Allah mengharamkan kamu menderhakai ibu-ibu kamu.", "image": "assets/images/hadis/hadis02.jpg", "audio": "assets/audio/hadis/hadis-02.mp3", "introAudio": "assets/audio/hadis/hadis-02-ms.mp3" },
        { "id": "hadis-03", "number": 3, "title": "Kebersihan Sebahagian Daripada Iman", "arabic": "الطُّهُورُ شَطْرُ الإِيمَانِ", "translation": "Kebersihan itu sebahagian daripada iman.", "image": "assets/images/hadis/hadis03.jpg", "audio": "assets/audio/hadis/hadis-03.mp3", "introAudio": "assets/audio/hadis/hadis-03-ms.mp3" },
        { "id": "hadis-04", "number": 4, "title": "Larangan Makan dan Minum Sambil Berdiri", "arabic": "لَا يَشْرَبَنَّ أَحَدٌ مِنْكُمْ قَائِمًا", "translation": "Janganlah seseorang daripada kamu makan dan minum sambil berdiri.", "image": "assets/images/hadis/hadis04.jpg", "audio": "assets/audio/hadis/hadis-04.mp3", "introAudio": "assets/audio/hadis/hadis-04-ms.mp3" },
        { "id": "hadis-05", "number": 5, "title": "Sabar", "arabic": "وَمَا أُعْطِيَ أَحَدٌ عَطَاءً خَيْرًا وَأَوْسَعَ مِنَ الصَّبْرِ", "translation": "Tiada pemberian yang lebih baik dan lebih luas daripada sabar.", "image": "assets/images/hadis/hadis05.jpg", "audio": "assets/audio/hadis/hadis-05.mp3", "introAudio": "assets/audio/hadis/hadis-05-ms.mp3" },
        { "id": "hadis-06", "number": 6, "title": "Malu", "arabic": "إِنَّ الْحَيَاءَ مِنَ الإِيمَانِ", "translation": "Sesungguhnya malu itu sebahagian daripada iman.", "image": "assets/images/hadis/hadis06.jpg", "audio": "assets/audio/hadis/hadis-06.mp3", "introAudio": "assets/audio/hadis/hadis-06-ms.mp3" },
        { "id": "hadis-07", "number": 7, "title": "Bakhil", "arabic": "لَا يَجْتَمِعُ شُحٌّ وَإِيمَانٌ فِي قَلْبِ رَجُلٍ مُسْلِمٍ", "translation": "Sifat bakhil dan iman tidak akan berkumpul dalam hati seorang Muslim.", "image": "assets/images/hadis/hadis07.jpg", "audio": "assets/audio/hadis/hadis-07.mp3", "introAudio": "assets/audio/hadis/hadis-07-ms.mp3" },
        { "id": "hadis-08", "number": 8, "title": "Larangan Menghasut", "arabic": "لَا يَدْخُلُ الْجَنَّةَ نَمَّامٌ", "translation": "Orang yang menghasut tidak akan masuk syurga.", "image": "assets/images/hadis/hadis08.jpg", "audio": "assets/audio/hadis/hadis-08.mp3", "introAudio": "assets/audio/hadis/hadis-08-ms.mp3" },
        { "id": "hadis-09", "number": 9, "title": "Doa yang Diperkenankan", "arabic": "يُسْتَجَابُ لِأَحَدِكُمْ مَا لَمْ يَعْجَلْ", "translation": "Doa salah seorang kamu akan diperkenankan selagi dia tidak tergesa-gesa.", "image": "assets/images/hadis/hadis09.jpg", "audio": "assets/audio/hadis/hadis-09.mp3", "introAudio": "assets/audio/hadis/hadis-09-ms.mp3" },
        { "id": "hadis-10", "number": 10, "title": "Elok Budi Pekerti", "arabic": "أَفْضَلُ الْمُؤْمِنِينَ أَحْسَنُهُمْ خُلُقًا", "translation": "Mukmin yang paling baik ialah yang paling elok akhlaknya.", "image": "assets/images/hadis/hadis10.jpg", "audio": "assets/audio/hadis/hadis-10.mp3", "introAudio": "assets/audio/hadis/hadis-10-ms.mp3" },
        { "id": "hadis-11", "number": 11, "title": "Solat Tiang Agama", "arabic": "رَأْسُ الأَمْرِ الإِسْلَامُ وَعَمُودُهُ الصَّلَاةُ", "translation": "Pokok urusan ialah Islam dan tiangnya ialah solat.", "image": "assets/images/hadis/hadis11.jpg", "audio": "assets/audio/hadis/hadis-11.mp3", "introAudio": "assets/audio/hadis/hadis-11-ms.mp3" },
        { "id": "hadis-12", "number": 12, "title": "Pewaris Nabi", "arabic": "الْعُلَمَاءُ وَرَثَةُ الأَنْبِيَاءِ", "translation": "Para ulama adalah pewaris para nabi.", "image": "assets/images/hadis/hadis12.jpg", "audio": "assets/audio/hadis/hadis-12.mp3", "introAudio": "assets/audio/hadis/hadis-12-ms.mp3" },
        { "id": "hadis-13", "number": 13, "title": "Kata-Kata yang Baik itu Sedekah", "arabic": "الْكَلِمَةُ الطَّيِّبَةُ صَدَقَةٌ", "translation": "Kata-kata yang baik itu adalah sedekah.", "image": "assets/images/hadis/hadis13.jpg", "audio": "assets/audio/hadis/hadis-13.mp3", "introAudio": "assets/audio/hadis/hadis-13-ms.mp3" },
        { "id": "hadis-14", "number": 14, "title": "Kewajipan Menuntut Ilmu", "arabic": "طَلَبُ الْعِلْمِ فَرِيضَةٌ عَلَى كُلِّ مُسْلِمٍ", "translation": "Menuntut ilmu itu wajib ke atas setiap Muslim.", "image": "assets/images/hadis/hadis14.jpg", "audio": "assets/audio/hadis/hadis-14.mp3", "introAudio": "assets/audio/hadis/hadis-14-ms.mp3" },
        { "id": "hadis-15", "number": 15, "title": "Sebaik-Baik Manusia", "arabic": "خَيْرُ النَّاسِ أَنْفَعُهُمْ لِلنَّاسِ", "translation": "Sebaik-baik manusia ialah yang paling bermanfaat kepada manusia.", "image": "assets/images/hadis/hadis15.jpg", "audio": "assets/audio/hadis/hadis-15.mp3", "introAudio": "assets/audio/hadis/hadis-15-ms.mp3" },
        { "id": "hadis-16", "number": 16, "title": "Persaudaraan (Silaturahim)", "arabic": "وَمَنْ كَانَ يُؤْمِنُ بِاللَّهِ وَالْيَوْمِ الآخِرِ فَلْيَصِلْ رَحِمَهُ", "translation": "Sesiapa beriman kepada Allah dan hari akhirat, maka hendaklah dia menyambung silaturahim.", "image": "assets/images/hadis/hadis16.jpg", "audio": "assets/audio/hadis/hadis-16.mp3", "introAudio": "assets/audio/hadis/hadis-16-ms.mp3" },
        { "id": "hadis-17", "number": 17, "title": "Larangan Makan dengan Tangan Kiri", "arabic": "لَا تَأْكُلُوا بِالشِّمَالِ، فَإِنَّ الشَّيْطَانَ يَأْكُلُ بِالشِّمَالِ", "translation": "Jangan makan dengan tangan kiri, kerana syaitan makan dengan tangan kiri.", "image": "assets/images/hadis/hadis17.jpg", "audio": "assets/audio/hadis/hadis-17.mp3", "introAudio": "assets/audio/hadis/hadis-17-ms.mp3" },
        { "id": "hadis-18", "number": 18, "title": "Solat yang Afdal", "arabic": "إِنَّ أَفْضَلَ الصَّلَاةِ صَلَاةُ الْمَرْءِ فِي بَيْتِهِ إِلَّا الْمَكْتُوبَةَ", "translation": "Solat yang paling afdal ialah solat seseorang di rumahnya, kecuali solat fardu.", "image": "assets/images/hadis/hadis18.jpg", "audio": "assets/audio/hadis/hadis-18.mp3", "introAudio": "assets/audio/hadis/hadis-18-ms.mp3" },
        { "id": "hadis-19", "number": 19, "title": "Halal dan Haram", "arabic": "الْحَلَالُ بَيِّنٌ وَالْحَرَامُ بَيِّنٌ وَبَيْنَهُمَا مُشْتَبِهَاتٌ", "translation": "Halal itu jelas dan haram itu jelas, dan di antara keduanya ada perkara syubhah.", "image": "assets/images/hadis/hadis19.jpg", "audio": "assets/audio/hadis/hadis-19.mp3", "introAudio": "assets/audio/hadis/hadis-19-ms.mp3" },
        { "id": "hadis-20", "number": 20, "title": "Amalan yang Baik", "arabic": "أَحَبُّ الأَعْمَالِ إِلَى اللَّهِ أَدْوَمُهَا وَإِنْ قَلَّ", "translation": "Amalan yang paling Allah cintai ialah yang konsisten walaupun sedikit.", "image": "assets/images/hadis/hadis20.jpg", "audio": "assets/audio/hadis/hadis-20.mp3", "introAudio": "assets/audio/hadis/hadis-20-ms.mp3" }
      ]
    },
